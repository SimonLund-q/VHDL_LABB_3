library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity kodlas is
    port(clk, reset: in std.logic;
    x1, x0: in std_logic;
    q0, q1: out std_logic;
    q0_plus, q1_plus: out std_logic;
    u: out std.logic
    );
end kodlas;

architecture rtl of kodlas is
    type prom is array (0 to 15)
        of std_logic_vector(2 downto 0)
    
    constant PROM : prom : = (
        0  => "001",
        1  => "000",
        2  => "000",
        3  => "000",
        4  => "001",
        5  => "010",
        6  => "000",
        7  => "000",
        8  => "000",
        9  => "010",
        10 => "000",
        11 => "011",
        12 => "100",
        13 => "111",
        14 => "111",
        15 => "111"
    );

    signal data : std_logic_vector(2 downto 0);
    signal addr : unsigned(3 downto 0);
begin
    addr <= unsigned(x1 & x0 & q1 & q0);
    data <= PROM(to_integer(addr));

    u         <= data(2);
    q1_plus  <= data(1);
    q0_plus  <= data(0);

    flip_flop_1: entity work.D_flip_flop
        port map(
            d => q1,
            clk => clk,
            q => q1_plus
        );

    flip_flop_0 : entity work.D_flip_flop
    port map (
        d   => q0,
        clk => clk,
        q   => q0_plus
    );

end architecture;